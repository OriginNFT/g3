# Copy to .env and fill in. Never commit .env.

# Same database gold3.sync writes into.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/gold3

# Sessions and login lockouts live here - this service cannot serve while redis
# is down.
REDIS_URL=redis://127.0.0.1:6379

NETWORK=anubis
PORT=3300

# Origins allowed to call this API, comma separated. Empty means same origin
# only, which is what you want when nginx serves the panel and this API from the
# same host.
# ADMIN_CORS_ORIGINS=https://admin.example.com

# Session lifetime. No sliding renewal: re-login costs one code.
ADMIN_SESSION_TTL_SECONDS=43200

# Login throttling, per username.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_SECONDS=900

# TOTP drift tolerance in 30-second steps either side of now. 1 covers ordinary
# clock skew; raising it widens the window an intercepted code stays usable in.
ADMIN_TOTP_WINDOW=1
ADMIN_TOTP_ISSUER=GOLDEN PACT Admin

# Set only when automating create-admin; otherwise it prompts.
# ADMIN_PASSWORD=

# DB_LOGGING=true
