# --- chain ---
# Network key inside config/addresses.json
NETWORK=anubis
CHAIN_ID=6714
RPC_URL=https://rpc2.anubispace.org

# --- database / redis ---
DATABASE_URL=postgres://user:password@127.0.0.1:5432/gold3
DB_LOGGING=false
REDIS_URL=redis://127.0.0.1:6379

# --- sync loop (listeners) ---
# Blocks kept behind the chain head to survive reorgs
CONFIRM_BLOCKS=16
# Blocks fetched per getLogs range (inclusive width)
BLOCK_STEP=500
# Seconds to sleep once a listener has caught up with the chain head
SLEEP_INTERVAL=15

# --- cursors ---
# The block cursor lives in Redis (SYNC:CURSOR:<service>). These values are only
# used the first time a service runs, when Redis has no cursor yet. Set it to
# the deployment block: 0 makes every listener scan from genesis.
START_BLOCK=0
# Per service override (service name uppercased, '-' -> '_'):
# START_BLOCK_POSITION=0

# --- keepers (services that SEND transactions) ---
# A --dry-run works without a key.
# oracle-updater: OracleAdapter.update() is permissionless, the key only pays gas.
ORACLE_UPDATER_PK=
# daily-settlement: the wallet holding KEEPER_ROLE on EmissionController.
SETTLEMENT_PK=
# buyback: the wallet holding KEEPER_ROLE on BuybackExecutor.
BUYBACK_PK=
# Smallest budget (whole tokenIn units, USDT) worth a buyback transaction.
BUYBACK_MIN_BUDGET=100
# Extra bps kept inside the contract's maxSlippageBps when computing minOut.
BUYBACK_SLIPPAGE_MARGIN_BPS=50
# community-accountant: the wallet holding ACCOUNTANT_ROLE on CommunityEngine.
ACCOUNTANT_PK=
# Rows per CommunityEngine.credit transaction. Sized against KEEPER_GAS_LIMIT:
# the keeper pre-flights estimateGas and refuses a batch that would not fit.
COMMUNITY_BATCH_SIZE=40
# Poll cadence; every tick re-checks the on-chain state before spending gas.
KEEPER_TICK_INTERVAL_SECONDS=60
# Fixed gas price in gwei; leave empty to use the node's suggestion.
KEEPER_GAS_PRICE_GWEI=
KEEPER_GAS_LIMIT=1500000
# Days the settlement keeper settles in one settleUpTo() call when it has fallen behind.
SETTLE_MAX_DAYS_PER_TICK=3
