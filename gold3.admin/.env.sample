# Copy to .env.local for development. Vite only exposes VITE_-prefixed vars.

# Where `npm run dev` proxies /api. In production nginx serves the built files
# and the admin API from the same origin, so nothing is needed there.
VITE_API_PROXY=http://127.0.0.1:3300

# Dev server port.
VITE_PORT=5300

# Only if the API is NOT on the same origin as the panel. Leave unset when nginx
# serves both - then ADMIN_CORS_ORIGINS on the API can stay empty too.
# VITE_API_BASE=https://admin-api.example.com

# Chain reads happen in the browser, not through the admin API.
VITE_RPC_URL=https://rpc2.anubispace.org
VITE_CHAIN_ID=6714
# Which block of src/assets/addresses.json the panel signs against (build time).
VITE_NETWORK=anubis

# Where the contract-settings pages link transactions and addresses.
VITE_EXPLORER_URL=https://browser.anubispace.org
